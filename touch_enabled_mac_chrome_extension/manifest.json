{
  "manifest_version": 3,
  "name": "TE Mac — Touch Enabled Mac",
  "version": "1.3.0",
  "description": "iPad-style on-screen keyboard for any input field on any site. Auto-enables on touch screens; toggle any time from the toolbar.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://suggestqueries-clients6.youtube.com/*",
    "https://api.datamuse.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TE Mac: toggle on-screen keyboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["te-keyboard.js"],
      "css": ["te-keyboard.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["yt-media.js"],
      "css": ["yt-media.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
